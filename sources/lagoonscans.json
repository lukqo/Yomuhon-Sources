{
  "schemaVersion": 1,
  "id": "lagoonscans",
  "name": "Lagoon Scans",
  "version": 1,
  "language": "en",
  "baseURL": "https://lagoonscans.com",
  "engineMode": "html",
  "enabledByDefault": false,
  "experimental": true,
  "allowedDomains": [
    "lagoonscans.com"
  ],
  "supports": {
    "search": true,
    "popular": true,
    "details": true,
    "chapters": true,
    "pages": true,
    "genres": false
  },
  "network": {
    "headers": {
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
      "User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 12_7) AppleWebKit/605.1.15 (KHTML, like Gecko) Yomuhon/1.0",
      "Referer": "https://lagoonscans.com/"
    }
  },
  "routes": {
    "popular": {
      "path": "/manga",
      "query": {
        "title": "",
        "order": "popular",
        "page": "1"
      }
    },
    "search": {
      "path": "/manga",
      "query": {
        "title": "{{query}}",
        "page": "1"
      }
    }
  },
  "selectors": {
    "popular": {
      "container": ".listupd .bs .bsx, .listo .bs .bsx, .utao .uta .imgu",
      "title": {
        "selectors": [
          "a"
        ],
        "attrs": [
          "title"
        ],
        "cleanup": [
          "decodeEntities",
          "normalizeWhitespace"
        ],
        "required": true
      },
      "url": {
        "selectors": [
          "a"
        ],
        "attrs": [
          "href"
        ],
        "required": true
      },
      "cover": {
        "selectors": [
          "img"
        ],
        "attrs": [
          "data-lazy-src",
          "data-src",
          "data-cfsrc",
          "src"
        ]
      }
    },
    "search": {
      "container": ".listupd .bs .bsx, .listo .bs .bsx, .utao .uta .imgu",
      "title": {
        "selectors": [
          "a"
        ],
        "attrs": [
          "title"
        ],
        "cleanup": [
          "decodeEntities",
          "normalizeWhitespace"
        ],
        "required": true
      },
      "url": {
        "selectors": [
          "a"
        ],
        "attrs": [
          "href"
        ],
        "required": true
      },
      "cover": {
        "selectors": [
          "img"
        ],
        "attrs": [
          "data-lazy-src",
          "data-src",
          "data-cfsrc",
          "src"
        ]
      }
    },
    "details": {
      "title": {
        "selectors": [
          "h1.entry-title"
        ],
        "attrs": [
          "text"
        ],
        "cleanup": [
          "decodeEntities",
          "normalizeWhitespace"
        ],
        "required": true
      },
      "synopsis": {
        "selectors": [
          ".entry-content[itemprop='description']",
          ".desc"
        ],
        "attrs": [
          "text"
        ],
        "cleanup": [
          "decodeEntities",
          "normalizeWhitespace"
        ]
      },
      "cover": {
        "selectors": [
          "div[itemprop='image'] img",
          ".thumb img"
        ],
        "attrs": [
          "data-lazy-src",
          "data-src",
          "src"
        ]
      }
    },
    "chapters": {
      "container": "#chapterlist li",
      "title": {
        "selectors": [
          ".chapternum",
          "a"
        ],
        "attrs": [
          "text"
        ],
        "cleanup": [
          "decodeEntities",
          "normalizeWhitespace"
        ]
      },
      "url": {
        "selectors": [
          "a"
        ],
        "attrs": [
          "href"
        ],
        "required": true
      },
      "number": {
        "from": "url",
        "regex": "chapter-([0-9]+(?:\\.[0-9]+)?)"
      },
      "sort": "numberDescending"
    },
    "pages": {
      "extractors": [
        {
          "type": "css",
          "selector": "div#readerarea img",
          "attrs": [
            "data-lazy-src",
            "data-src",
            "data-cfsrc",
            "src"
          ]
        },
        {
          "type": "regex",
          "pattern": "(https?:\\\\?/\\\\?/[^\"']+?\\.(?:jpg|jpeg|png|webp)(?:\\?[^\"']*)?)"
        }
      ],
      "filters": {
        "mustContain": [
          ".jpg",
          ".jpeg",
          ".png",
          ".webp"
        ],
        "blockContains": [
          "logo",
          "avatar",
          "placeholder",
          "banner",
          "ads/",
          "icon",
          "favicon",
          "sprite"
        ]
      }
    }
  },
  "cleanup": {
    "decodeHTMLEntities": true,
    "normalizeWhitespace": true,
    "removeText": []
  },
  "tests": {
    "query": "solo leveling",
    "minSearchResults": 1,
    "minChapters": 1,
    "minPages": 1
  }
}
