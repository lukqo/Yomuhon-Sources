{
  "schemaVersion": 1,
  "id": "lectormanga_es",
  "name": "LectorManga",
  "version": 1,
  "language": "es",
  "baseURL": "https://lectormanga.com",
  "engineMode": "html",
  "enabledByDefault": false,
  "experimental": true,
  "allowedDomains": [
    "lectormanga.com"
  ],
  "supports": {
    "search": true,
    "popular": true,
    "details": true,
    "chapters": true,
    "pages": true,
    "genres": false
  },
  "network": {
    "headers": {
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
      "User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 12_7) AppleWebKit/605.1.15 (KHTML, like Gecko) Yomuhon/1.0",
      "Referer": "https://lectormanga.com/"
    }
  },
  "routes": {
    "popular": {
      "path": "/"
    },
    "search": {
      "path": "/library",
      "query": {
        "title": "{{query}}"
      }
    }
  },
  "selectors": {
    "popular": {
      "container": "a[href*='/library/']",
      "title": {
        "attrs": [
          "title",
          "text"
        ],
        "cleanup": [
          "decodeEntities",
          "normalizeWhitespace"
        ]
      },
      "url": {
        "attrs": [
          "href"
        ],
        "required": true
      },
      "cover": {
        "selectors": [
          "img"
        ],
        "attrs": [
          "src",
          "data-src",
          "data-original"
        ]
      }
    },
    "search": {
      "container": "a[href*='/library/']",
      "title": {
        "attrs": [
          "title",
          "text"
        ],
        "cleanup": [
          "decodeEntities",
          "normalizeWhitespace"
        ]
      },
      "url": {
        "attrs": [
          "href"
        ],
        "required": true
      },
      "cover": {
        "selectors": [
          "img"
        ],
        "attrs": [
          "src",
          "data-src",
          "data-original"
        ]
      }
    },
    "details": {
      "title": {
        "selectors": [
          "meta[property='og:title']",
          "h1"
        ],
        "attrs": [
          "content",
          "text"
        ],
        "cleanup": [
          "decodeEntities",
          "normalizeWhitespace"
        ]
      },
      "synopsis": {
        "selectors": [
          "meta[name='description']",
          "meta[property='og:description']"
        ],
        "attrs": [
          "content"
        ],
        "cleanup": [
          "stripHTML",
          "decodeEntities",
          "normalizeWhitespace"
        ]
      },
      "cover": {
        "selectors": [
          "meta[property='og:image']",
          "img"
        ],
        "attrs": [
          "content",
          "src",
          "data-src"
        ]
      }
    },
    "chapters": {
      "container": "div#chapters li",
      "title": {
        "selectors": [
          "h4"
        ],
        "attrs": [
          "title",
          "text"
        ],
        "cleanup": [
          "decodeEntities",
          "normalizeWhitespace"
        ]
      },
      "url": {
        "selectors": [
          "a"
        ],
        "attrs": [
          "href"
        ],
        "required": true
      },
      "number": {
        "from": "text",
        "regex": "(?:Cap[ií]tulo|Chapter)\\s*([0-9]+(?:\\.[0-9]+)?)"
      },
      "sort": "numberAscending"
    },
    "pages": {
      "extractors": [
        {
          "type": "css",
          "selector": "div#main-container img",
          "attrs": [
            "data-src",
            "data-original",
            "srcset",
            "src"
          ]
        },
        {
          "type": "regex",
          "pattern": "(https?:\\\\?/\\\\?/[^\"'\\\\\\s]*lectormanga\\.com/[^\"'\\\\\\s]+?\\.(?:jpg|jpeg|png|webp)(?:\\?[^\"'\\\\\\s]*)?)"
        }
      ],
      "filters": {
        "mustContain": [
          ".jpg",
          ".jpeg",
          ".png",
          ".webp"
        ],
        "blockContains": [
          "logo",
          "avatar",
          "placeholder",
          "banner",
          "ads/",
          "icon",
          "favicon",
          "sprite",
          "gravatar",
          "covers/"
        ]
      }
    }
  },
  "discover": {
    "popular": {
      "route": {
        "path": "/"
      },
      "selector": {
        "container": "a[href*='/library/']",
        "title": {
          "attrs": [
            "title",
            "text"
          ],
          "cleanup": [
            "decodeEntities",
            "normalizeWhitespace"
          ]
        },
        "url": {
          "attrs": [
            "href"
          ],
          "required": true
        },
        "cover": {
          "selectors": [
            "img"
          ],
          "attrs": [
            "src",
            "data-src",
            "data-original"
          ]
        }
      }
    }
  },
  "cleanup": {
    "decodeHTMLEntities": true,
    "normalizeWhitespace": true,
    "removeText": [
      "LectorManga",
      "Leer online"
    ]
  },
  "tests": {
    "query": "one piece",
    "minSearchResults": 1,
    "minChapters": 1,
    "minPages": 1
  }
}
