{
  "schemaVersion": 1,
  "id": "olympusbiblioteca",
  "name": "Olympus Scanlation",
  "version": 1,
  "language": "es",
  "baseURL": "https://olympusbiblioteca.com",
  "engineMode": "html",
  "enabledByDefault": false,
  "experimental": true,
  "allowedDomains": [
    "olympusbiblioteca.com",
    "olympusbiblioteca.net"
  ],
  "supports": {
    "search": true,
    "popular": true,
    "details": true,
    "chapters": true,
    "pages": true,
    "genres": false
  },
  "network": {
    "headers": {
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
      "User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 12_7) AppleWebKit/605.1.15 (KHTML, like Gecko) Yomuhon/1.0",
      "Referer": "https://olympusbiblioteca.com/"
    }
  },
  "routes": {
    "popular": {
      "path": "/manga",
      "query": {
        "m_orderby": "trending",
        "page": "1"
      }
    },
    "search": {
      "path": "/",
      "query": {
        "s": "{{query}}",
        "post_type": "wp-manga",
        "page": "1"
      }
    }
  },
  "selectors": {
    "popular": {
      "container": ".page-item-detail, .c-tabs-item__content .c-tabs-item, .manga .page-item-detail",
      "title": {
        "selectors": [
          ".post-title h3 a",
          ".post-title h4 a",
          ".post-title a"
        ],
        "attrs": [
          "title",
          "text"
        ],
        "cleanup": [
          "decodeEntities",
          "normalizeWhitespace"
        ],
        "required": true
      },
      "url": {
        "selectors": [
          ".post-title h3 a",
          ".post-title h4 a",
          ".post-title a"
        ],
        "attrs": [
          "href"
        ],
        "required": true
      },
      "cover": {
        "selectors": [
          ".tab-thumb img",
          ".item-thumb img",
          "img"
        ],
        "attrs": [
          "data-src",
          "data-lazy-src",
          "src"
        ]
      }
    },
    "search": {
      "container": ".c-tabs-item__content, .row.c-tabs-item, .page-item-detail",
      "title": {
        "selectors": [
          ".post-title h3 a",
          ".post-title h4 a",
          ".post-title a"
        ],
        "attrs": [
          "title",
          "text"
        ],
        "cleanup": [
          "decodeEntities",
          "normalizeWhitespace"
        ],
        "required": true
      },
      "url": {
        "selectors": [
          ".post-title h3 a",
          ".post-title h4 a",
          ".post-title a"
        ],
        "attrs": [
          "href"
        ],
        "required": true
      },
      "cover": {
        "selectors": [
          ".tab-thumb img",
          ".item-thumb img",
          "img"
        ],
        "attrs": [
          "data-src",
          "data-lazy-src",
          "src"
        ]
      }
    },
    "details": {
      "title": {
        "selectors": [
          ".post-title h1",
          "h1.entry-title"
        ],
        "attrs": [
          "text"
        ],
        "cleanup": [
          "decodeEntities",
          "normalizeWhitespace"
        ],
        "required": true
      },
      "synopsis": {
        "selectors": [
          ".summary__content",
          ".description-summary .summary__content",
          ".entry-content p"
        ],
        "attrs": [
          "text"
        ],
        "cleanup": [
          "decodeEntities",
          "normalizeWhitespace"
        ]
      },
      "cover": {
        "selectors": [
          ".summary_image img",
          ".tab-summary .summary_image img"
        ],
        "attrs": [
          "data-src",
          "data-lazy-src",
          "src"
        ]
      }
    },
    "chapters": {
      "container": "li.wp-manga-chapter, .listing-chapters_wrap li",
      "title": {
        "selectors": [
          "a"
        ],
        "attrs": [
          "text"
        ],
        "cleanup": [
          "decodeEntities",
          "normalizeWhitespace"
        ]
      },
      "url": {
        "selectors": [
          "a"
        ],
        "attrs": [
          "href"
        ],
        "required": true
      },
      "number": {
        "from": "url",
        "regex": "(?:capitulo|chapter)-([0-9]+(?:\\.[0-9]+)?)"
      },
      "sort": "numberDescending"
    },
    "pages": {
      "extractors": [
        {
          "type": "css",
          "selector": ".reading-content img, div#readerarea img",
          "attrs": [
            "data-src",
            "data-lazy-src",
            "src"
          ]
        },
        {
          "type": "regex",
          "pattern": "(https?:\\\\?/\\\\?/[^\"']+?\\.(?:jpg|jpeg|png|webp)(?:\\?[^\"']*)?)"
        }
      ],
      "filters": {
        "mustContain": [
          ".jpg",
          ".jpeg",
          ".png",
          ".webp"
        ],
        "blockContains": [
          "logo",
          "avatar",
          "placeholder",
          "banner",
          "ads/",
          "icon",
          "favicon",
          "sprite"
        ]
      }
    }
  },
  "cleanup": {
    "decodeHTMLEntities": true,
    "normalizeWhitespace": true,
    "removeText": []
  },
  "tests": {
    "query": "solo leveling",
    "minSearchResults": 1,
    "minChapters": 1,
    "minPages": 1
  }
}
